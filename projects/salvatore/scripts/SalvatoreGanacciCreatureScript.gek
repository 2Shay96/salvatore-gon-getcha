scn SalvatoreGanacciCreatureScript

ref rUser
short HideBody
; A5: append variables; poll animation action per frame to catch fast punches.
short SpeechInit
short AnimAction
short IdleChoice
short AttackSamples
short AttackQuipsPlayed
short IdleQuipsPlayed
float SpeechDelta
float VoiceBusy
float AttackCooldown
float IdleGap
; M4: append variables; shoe is visual-only on this same persistent actor.
short ShoePlaying
float ShoeRetry
short ShoeDebugShown
float ShoeX
float ShoeY
float ShoeZ

Begin OnLoad
	SetAV DamageThreshold 5
	set ShoePlaying to 0
	set ShoeRetry to 0
	SetActorAlpha 1
	SalvatoreGanacciShoeREF.Disable
	set SalvatoreGanacciQuest.ShoeVisualActive to 0
End

Begin OnDeath
	SalvatoreGanacciShoeREF.Disable
	SetActorAlpha 1
	set SalvatoreGanacciQuest.ShoeVisualActive to 0
	set ShoePlaying to 0
	if player.GetItemCount SalvatoreGanacciWeapon == 0 && (SalvatoreGanacciQuest.State == 1 || SalvatoreGanacciQuest.State == 4)
	; leave the small Salvatore at once, standing where he fell (its collision is static, so it cannot drop)
	SalvatoreGanacciDownREF.MoveTo SalvatoreGanacciREF 0 0 0
	SalvatoreGanacciDownREF.Enable
	; Queue the sting until the moved/enabled emitter has loaded.
	set SalvatoreGanacciQuest.DefeatCuePending to 1
	set HideBody to 1
	set SalvatoreGanacciQuest.DeathPending to 1
	endif
End

Begin GameMode
	; Decide once per save/encounter; companion deployment never uses the entrance.
	if GetDead == 0 && GetDisabled == 0
		if SalvatoreGanacciQuest.ShoeArmDelay > 0
			set ShoeDebugShown to 0
		endif
		if SalvatoreGanacciQuest.State == 1 && SalvatoreGanacciQuest.ShoeStage == 0 && SalvatoreGanacciQuest.ShoeArmDelay <= 0
			if GetDistance player > 700 && player.IsInInterior == 0
				set SalvatoreGanacciQuest.ShoeStage to 1
			else
				set SalvatoreGanacciQuest.ShoeStage to 2
			endif
		endif
		if SalvatoreGanacciQuest.ShoeStage == 1
			if GetDistance player <= 700 || player.IsInInterior == 1 || SalvatoreGanacciQuest.State != 1
				set SalvatoreGanacciQuest.ShoeStage to 2
			endif
		endif
		if SalvatoreGanacciQuest.State == 1 && SalvatoreGanacciQuest.ShoeStage == 1
			if ShoeDebugShown == 0
				; M5: retired diagnostic message; keep the saved flag and record stable.
				set ShoeDebugShown to 1
			endif
			; Direct ACTI rendering avoids the failed special-idle visibility layer.
			if ShoePlaying == 0 || SalvatoreGanacciShoeREF.GetDisabled == 1 || SalvatoreGanacciQuest.ShoeVisualActive == 0
				PlayGroup Idle 1
				SalvatoreGanacciShoeREF.MoveTo SalvatoreGanacciREF
				SalvatoreGanacciShoeREF.Enable
				set SalvatoreGanacciQuest.ShoeVisualActive to 1
				set ShoePlaying to 1
			endif
			if SalvatoreGanacciShoeREF.GetDistance SalvatoreGanacciREF > 1024
				SalvatoreGanacciShoeREF.MoveTo SalvatoreGanacciREF
			endif
			set ShoeX to GetPos x
			set ShoeY to GetPos y
			set ShoeZ to GetPos z
			SalvatoreGanacciShoeREF.SetPos x ShoeX
			SalvatoreGanacciShoeREF.SetPos y ShoeY
			SalvatoreGanacciShoeREF.SetPos z ShoeZ
			SetActorAlpha 0
		elseif ShoePlaying == 1
			SalvatoreGanacciShoeREF.Disable
			SetActorAlpha 1
			set SalvatoreGanacciQuest.ShoeVisualActive to 0
			EvaluatePackage
			set ShoePlaying to 0
		endif
	else
		; Keep a pending cleanup across death/disable until this actor is alive again.
		set ShoeRetry to 0
	endif

	; hide the big sprite two frames later (the drop needs his position for a frame)
	if HideBody > 0
		set HideBody to HideBody + 1
		if HideBody >= 3
			set HideBody to 0
			if GetDead == 1
				Disable
			endif
		endif
	endif

	set SpeechDelta to GetSecondsPassed
	if VoiceBusy > 0
		set VoiceBusy to VoiceBusy - SpeechDelta
	endif
	if AttackCooldown > 0
		set AttackCooldown to AttackCooldown - SpeechDelta
	endif
	if GetDead == 0 && GetDisabled == 0 && (SalvatoreGanacciQuest.State == 1 || SalvatoreGanacciQuest.State == 4)
		; A deployment can reuse this actor without re-running OnLoad.
		if SpeechInit == 0 || SalvatoreGanacciQuest.ReleaseCuePending > 0
			set SpeechInit to 1
			set IdleGap to 2 + (GetRandomPercent * 0.08)
			set AttackCooldown to 2
		endif
		set AnimAction to GetAnimAction
		if IsInCombat == 1 || AnimAction == 2
			; Cancel the idle countdown. A started short clip finishes naturally.
			set IdleGap to 1 + (GetRandomPercent * 0.09)
			if AnimAction == 2
				set AttackSamples to AttackSamples + 1
				if VoiceBusy <= 0 && AttackCooldown <= 0
					; Failed rolls cannot retry every frame of the same fast attack.
					set AttackCooldown to 1
					if GetRandomPercent < 40
						PlaySound3D SalvatoreGanacciAttackQuipSound
						set VoiceBusy to 2.05
						set AttackCooldown to 4 + (GetRandomPercent * 0.04)
						set AttackQuipsPlayed to AttackQuipsPlayed + 1
					endif
				endif
			endif
		elseif IsMoving == 0 && SalvatoreGanacciQuest.ReleaseCuePending == 0
			if VoiceBusy <= 0
				set IdleGap to IdleGap - SpeechDelta
				if IdleGap <= 0
					set IdleChoice to GetRandomPercent
					if IdleChoice < 50
						PlaySound3D SalvatoreGanacciIdleQuipSound
						set VoiceBusy to 2.05
					else
						PlaySound3D SalvatoreGanacciIdleQuip2Sound
						set VoiceBusy to 2.35
					endif
					set IdleGap to 1 + (GetRandomPercent * 0.09)
					set IdleQuipsPlayed to IdleQuipsPlayed + 1
				endif
			endif
		endif
	else
		set SpeechInit to 0
		set AttackCooldown to 0
		set IdleGap to 0
	endif

End

Begin OnActivate
	set rUser to GetActionRef
	if rUser.GetIsReference player && SalvatoreGanacciQuest.IsCompanion == 1
		set SalvatoreGanacciQuest.StoreRequest to 1
	endif
End
